{
  "name": "gkd-rule-studio",
  "version": "0.2.1",
  "private": true,
  "license": "SATA-2.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/check-windows.cjs && vite --host 127.0.0.1 --port 5174",
    "build": "node scripts/check-windows.cjs && tsc -b && vite build",
    "build:android-assets": "node scripts/check-windows.cjs && tsc -b && vite build --base ./ --outDir android/app/src/main/assets --emptyOutDir",
    "package:full": "node scripts/check-windows.cjs && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android.ps1",
    "test:android": "node scripts/check-windows.cjs && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android.ps1 -Task Test",
    "check:android-env": "node scripts/check-windows.cjs && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android.ps1 -Task Check",
    "check:android-wrapper": "node scripts/check-windows.cjs && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-android-build.ps1",
    "start": "node scripts/check-windows.cjs && vite preview --host 127.0.0.1 --port 5174",
    "preview": "node scripts/check-windows.cjs && vite preview --host 127.0.0.1 --port 5174",
    "test": "node scripts/check-windows.cjs && vitest run",
    "typecheck": "node scripts/check-windows.cjs && tsc -b --pretty false",
    "publish:update": "node scripts/publish-update.mjs",
    "check:update": "node scripts/check-update.mjs",
    "admin": "node admin/server.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@gkd-kit/selector": "^0.5.23",
    "@gkd-kit/selector-beta": "npm:@gkd-kit/selector@0.6.1",
    "json5": "^2.2.3",
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "^6.0.3",
    "vite": "^8.0.13",
    "vitest": "^4.1.6"
  }
}
