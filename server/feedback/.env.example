# Values are intentionally blank. Generate ADMIN_PASSWORD_HASH with:
# python -m app
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
SESSION_COOKIE_SECURE=true
FEEDBACK_DATA_DIR=/data

# Confirmed production entry. For the later domain migration use:
# PUBLIC_BASE_URL=https://feedback.kmttjnm.me
PUBLIC_BASE_URL=https://120.25.221.144/gkd-feedback/

# Exact browser origins, comma separated, without a path.
ALLOWED_ORIGINS=https://120.25.221.144
# Domain migration:
# ALLOWED_ORIGINS=https://feedback.kmttjnm.me

# Only list the reverse proxy address/CIDR that connects to Uvicorn.
# Never use 0.0.0.0/0 or trust an arbitrary internet peer.
TRUSTED_PROXY_IPS=

SUBMIT_RATE_COUNT=30
SUBMIT_RATE_WINDOW=60
# Successful writes only; duplicate idempotency responses do not consume budget.
SUBMIT_DAILY_IP_COUNT=20
SUBMIT_DAILY_IP_BYTES=16777216
SUBMIT_DAILY_GLOBAL_COUNT=200
SUBMIT_DAILY_GLOBAL_BYTES=67108864
SUBMIT_CONCURRENCY=2
LOGIN_RATE_COUNT=10
LOGIN_RATE_WINDOW=900
MAX_FEEDBACK_COUNT=10000
MAX_STORAGE_BYTES=536870912
MIN_FREE_DISK_BYTES=67108864
RETENTION_DAYS=90
MAINTENANCE_INTERVAL_SECONDS=3600
OUTBOX_POLL_INTERVAL_SECONDS=30

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=3428864257@qq.com
